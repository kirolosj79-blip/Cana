# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored — never commit real keys.

# Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️ Never put the "service_role" key here or anywhere in the frontend.
# Anything prefixed VITE_ is bundled into the JS shipped to every visitor's
# browser — the anon key is *designed* to be public (Row Level Security is
# what actually protects the data), but service_role bypasses RLS entirely
# and must only ever live server-side (e.g. a Vercel Function's own
# environment variables, set in the Vercel dashboard — never in a file).
